rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && request.auth.token.orgId == orgId;
    }

    // Packing videos are tenant-scoped: packing-videos/{orgId}/...
    // orgId is a Firebase Auth custom claim set by GET /api/me.
    match /packing-videos/{orgId}/{allPaths=**} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgMember(orgId)
                   && request.resource.contentType.matches('video/.*')
                   && request.resource.size <= 500 * 1024 * 1024;
    }
  }
}
