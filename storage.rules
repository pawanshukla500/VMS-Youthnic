rules_version = '2';

// Packing videos are isolated per organization: packing-videos/{orgId}/...
// The backend mirrors organization_members onto Firebase custom claims
// (`organization_id`, `role` — see server/src/middleware/auth.ts
// syncOrgClaims), so the rules below can enforce the boundary without a
// server round-trip.
//
// Claims propagate on the next ID-token refresh (Firebase refreshes hourly,
// and the client force-refreshes on 401), so tokens minted before that sync
// carry no claim yet: those are allowed through during the rollover window
// only. The server still re-checks organization_id on every metadata,
// download, and report call, and unguessable org UUIDs keep exact-path
// guessing infeasible in the meantime.
service firebase.storage {
  match /b/{bucket}/o {

    // Organization isolated path: packing-videos/{orgId}/{marketplace}/{year}/{month}/{day}/{orderId}/{filename}
    match /packing-videos/{orgId}/{allPaths=**} {

      // Allow read/download only for members of the owning org. Tokens
      // without a synced claim yet (pre-rollover) retain access so
      // in-shift packing PCs never break mid-upload.
      allow read: if request.auth != null &&
                     (request.auth.token.organization_id == null ||
                      request.auth.token.organization_id == orgId);

      // Allow upload for members of the owning org, enforce MP4 and size limits
      allow write: if request.auth != null &&
                      (request.auth.token.organization_id == null ||
                       request.auth.token.organization_id == orgId) &&
                      (request.resource.contentType.matches('video/.*')) &&
                      request.resource.size <= 500 * 1024 * 1024; // 500MB max per video
    }
  }
}
