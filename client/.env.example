# VMS Client Environment Variables
# PROD: set to the public backend origin (e.g. https://vms.youthnic.shop).
# The app falls back to the page origin when this is empty, but always set it
# explicitly for production builds.
VITE_API_URL=http://localhost:8080

# Optional upload path namespace. If omitted, uploads use packing-videos/default/...
VITE_ORG_ID=default

# Firebase Config (for frontend client)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_RECAPTCHA_KEY=your_recaptcha_enterprise_key

# OMSGuru (future): order + SKU/image lookup for the packing page.
# Leave empty until the integration is implemented in orderContext.ts.
VITE_OMSGURU_BASE_URL=
VITE_OMSGURU_API_KEY=
