# VMS Server Environment Variables
PORT=8080

# Allowed browser origins, comma-separated in production
# PROD: must include the public frontend origin, e.g. https://vms.youthnic.shop
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL connection string. Use your VPS-hosted Postgres URL in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vms

# Production Postgres SSL. Use require only when the database server has SSL enabled.
# For stronger verification, set PGSSL_CA_CERT or PGSSL_CA_CERT_PATH instead.
PGSSL_MODE=disable
PGSSL_CA_CERT=
PGSSL_CA_CERT_PATH=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Firebase Admin SDK service account JSON. Keep this secret.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Firebase/Cloud Storage bucket for videos.
# If omitted, the server derives <project_id>.firebasestorage.app from the service account JSON.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Local fallback upload directory. Current video uploads go directly to Firebase Storage.
STORAGE_DIR=uploads

# Development-only user provisioning. Keep false or unset in production.
AUTO_PROVISION_USERS=false

# Shared secret for Cloud Scheduler to call /api/jobs/order-mappings/reconcile at 1 AM.
ORDER_RECONCILE_SECRET=replace-with-long-random-secret

# Retention purge for import bookkeeping (POST /api/jobs/retention-purge,
# same cron secret as reconcile). Mappings older than this are stale —
# recordings are renamed at import time. Audit logs age out separately.
MAPPING_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# Shared secret for the daily-report cron job (POST /api/jobs/daily-report).
# Call with header x-report-secret or Authorization: Bearer <secret>.
# Supports ?date=YYYY-MM-DD (IST day, default today) and ?dryRun=1.
REPORT_JOB_SECRET=replace-with-long-random-secret

# Daily packing report email via Resend (https://resend.com).
# Verify the sender domain in Resend first, then set:
#   REPORT_FROM_EMAIL=PVMS Daily Report <reports@pkvm.youthnic.shop>
#   REPORT_TO_EMAILS=admin@youthnic.shop,manager@youthnic.shop
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAILS=

# Order data for the packing page: copied from the Forward Scan database
# (no OMSGuru API calls from VMS). Same URL format as Forward Scan's own
# DATABASE_URL: sqlite:////abs/path.db, sqlite:///relative.db or postgresql://...
# Production compose mounts Forward Scan's data dir at /forward-scan-data.
FORWARD_SCAN_DATABASE_URL=sqlite:////forward-scan-data/omsguru_forward_scan.db
# Keep this many days of orders (by AWB date). Default 3.
FORWARD_SCAN_RETENTION_DAYS=3
# Seconds between copy runs (30..3600, default 120).
FORWARD_SCAN_SYNC_INTERVAL_SECONDS=120
# Optional CSV of organization UUIDs that receive the copy (empty = all active).
FORWARD_SCAN_ORG_IDS=

# OMSGuru (server-side only — never expose the token to browsers). Only used
# by the admin "Test connection" button now; VMS no longer syncs from it.
OMSGURU_TOKEN=
OMSGURU_CID=
OMSGURU_WAREHOUSE_ID=6688,11951,11956,11957,11958,11959
