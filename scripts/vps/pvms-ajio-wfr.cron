# PVMS Ajio WFR runs — installed by the deploy workflow from
# scripts/vps/pvms-ajio-wfr.cron. 4x daily (00:30 / 06:30 / 12:30 / 18:30 IST;
# IST is UTC+5:30 year-round, no DST, so the UTC times below are exact).
# A missed CCTV reply risks an Ajio penalty, so frequency beats frugality:
# the job is idempotent (done rows skip, Drive links are reused) and the
# in-process safety net stands down whenever these runs succeed.
# (cron.d files must end with a blank line.)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 1,7,13,19 * * * root /opt/pvms/ajio-wfr-cron.sh >>/opt/pvms/ajio-wfr-cron.log 2>&1

