# Frontend Configuration
# PROD: must be the public backend origin (Traefik routes /api on the same
# domain). An empty value or localhost here breaks uploads only after deploy.
VITE_API_URL=http://localhost:8080
VITE_ORG_ID=default
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_KEY=

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vms
PORT=8080
# Dir of published PVMS-Packing-Setup-*.exe installers served from
# /api/downloads/* (packing page button + in-app auto-updater).
DESKTOP_DOWNLOAD_DIR=./downloads
ORDER_RECONCILE_SECRET=replace-with-long-random-secret
REPORT_JOB_SECRET=replace-with-long-random-secret
RESEND_API_KEY=
REPORT_FROM_EMAIL=PVMS Daily Report <reports@pkvm.youthnic.shop>
REPORT_TO_EMAILS=admin@youthnic.shop

# Ajio WFR CCTV job (VPS host cron 4x daily + in-process safety net ->
# POST /api/jobs/ajio-wfr). A missed reply risks an Ajio penalty, so failures,
# OAuth->App-Password fallbacks, and SLA breaches email the alert list at once.
# Gmail: one-click OAuth connect on the Ajio page (needs the OAuth client
# below); fallback is mailbox address + App Password (Google Account ->
# 2-Step Verification -> App passwords). KEEP THE FALLBACK SET — it auto-covers
# runs when the OAuth grant dies.
AJIO_WFR_SECRET=replace-with-long-random-secret
AJIO_GMAIL_ADDRESS=
AJIO_GMAIL_APP_PASSWORD=
AJIO_GMAIL_OAUTH_CLIENT_ID=
AJIO_GMAIL_OAUTH_CLIENT_SECRET=
# Trial mails (same subject, own mailbox) accepted alongside Ajio. Empty = Ajio only.
AJIO_TEST_SENDERS=
# Drive: Service Account JSON (IAM -> Service Accounts -> Keys) + share the
# target Drive folder with the service account email as Editor
AJIO_GDRIVE_SA_JSON=
AJIO_GDRIVE_FOLDER_ID=
# Failure/fallback/SLA-breach alerts (falls back to REPORT_TO_EMAILS).
AJIO_ALERT_EMAILS=
# In-process safety-net sweep interval, hours 1..24 (default 6).
AJIO_WFR_INTERVAL_HOURS=6
# Open-request escalation age, hours 1..72 (default 12).
AJIO_WFR_SLA_HOURS=12
