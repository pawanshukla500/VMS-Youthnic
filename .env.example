# Frontend Configuration
# PROD: must be the public backend origin (Traefik routes /api on the same
# domain). An empty value or localhost here breaks uploads only after deploy.
VITE_API_URL=http://localhost:8080
VITE_ORG_ID=default
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_KEY=

# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vms
PORT=8080
ORDER_RECONCILE_SECRET=replace-with-long-random-secret
REPORT_JOB_SECRET=replace-with-long-random-secret
RESEND_API_KEY=
REPORT_FROM_EMAIL=PVMS Daily Report <reports@pkvm.youthnic.shop>
REPORT_TO_EMAILS=admin@youthnic.shop
